# Barre des tâches de CHOS (tint2)
# Les lignes qui commencent par « #LIVE# » ne sont actives que sur la clé USB.

#-------------------------------------
# Fonds
# Fond 1 : la barre
rounded = 0
border_width = 0
background_color = #202124 100
border_color = #000000 0

# Fond 2 : fenêtre active
rounded = 6
border_width = 0
background_color = #3c4043 100
border_color = #000000 0

# Fond 3 : fenêtre inactive
rounded = 6
border_width = 0
background_color = #292a2d 100
border_color = #000000 0

#-------------------------------------
# Barre (masquée automatiquement : amène la souris tout en bas pour l'afficher)
panel_items = LTSBC
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_dock = 0
wm_menu = 1
autohide = 1
autohide_show_timeout = 0.3
autohide_hide_timeout = 1
autohide_height = 2
strut_policy = none
font_shadow = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 15

#-------------------------------------
# Liste des fenêtres
taskbar_mode = single_desktop
taskbar_padding = 0 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0

task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 240 32
task_padding = 8 4 6
task_font = Sans 10
task_font_color = #e8eaed 100
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 2
task_iconified_background_id = 3
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

#-------------------------------------
# Lanceurs (à gauche)
launcher_padding = 2 4 8
launcher_background_id = 0
launcher_icon_size = 28
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/google-chrome.desktop
#LIVE# launcher_item_app = /usr/share/applications/chos-install.desktop
launcher_item_app = /usr/share/applications/chos-power.desktop

#-------------------------------------
# Icônes système (Wi-Fi, son, Bluetooth)
systray_padding = 4 0 8
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 22

#-------------------------------------
# Batterie
battery_low_status = 10
battery_low_cmd = notify-send -u critical "Batterie faible" "Branche le chargeur !"
battery_padding = 4 0
battery_background_id = 0
battery_font_color = #e8eaed 100
bat1_font = Sans Bold 9
bat2_font = Sans 8

#-------------------------------------
# Horloge
time1_format = %H:%M
time2_format = %a %d %b
time1_font = Sans Bold 10
time2_font = Sans 8
clock_font_color = #e8eaed 100
clock_padding = 6 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y
